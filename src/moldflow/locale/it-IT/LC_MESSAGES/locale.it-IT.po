msgstr "L'oggetto risolto non ha alcun attributo chiamabile '{segment}' durante l'esecuzione del target '{target}'"

msgid "Run a Moldflow target with named parameters or JSON input. Bare targets are treated as synergy.<target>."
msgstr "Esegue un target Moldflow con parametri con nome o input JSON. I target senza prefisso sono trattati come synergy.<target>."

msgid "Save Error"
msgstr "Errore di salvataggio"

