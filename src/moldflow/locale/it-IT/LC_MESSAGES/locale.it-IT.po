msgstr "Parametro sconosciuto '{parameter}' per {target}{signature}.{extra}"

msgid "Use 'help <command>' for detailed help on a specific command."
msgstr "Usa 'help <comando>' per la guida dettagliata su un comando specifico."

msgid "Use JSON field '{preferred_field}' for '{param_name}'."
msgstr "Usa il campo JSON '{preferred_field}' per '{param_name}'."

msgid "Use JSON field '{preferred_field}'."
msgstr "Usa il campo JSON '{preferred_field}'."

msgid "Use a comma-separated list for quick CLI input, or a JSON array string when values contain commas."
msgstr "Usa un elenco separato da virgole per un input CLI rapido, oppure una stringa array JSON quando i valori contengono virgole."

msgid "Use a comma-separated triplet for vector shorthand."
msgstr "Usa una tripletta separata da virgole per la forma abbreviata del vettore."

msgid "Use describe <target> to inspect parameters, examples, and property behavior before invoking."
msgstr "Usa describe <target> per controllare parametri, esempi e comportamento della proprietà prima di invocare."

msgid "Use semicolon-separated triplets for quick CLI input. Quote the value in shells that treat semicolons specially."
msgstr "Usa triplette separate da punto e virgola per un input CLI rapido. Metti tra virgolette il valore nelle shell che trattano in modo speciale i punti e virgola."

msgid "Using prompts will use pop-up import options and will always show logs"
msgstr "Usando le richieste verranno utilizzate le opzioni di importazione a comparsa e verranno sempre mostrati i registri"

msgid "Using prompts will use pop-up import options instead of the ones provided."
msgstr "Usando le richieste verranno utilizzate le opzioni di importazione a comparsa invece di quelle fornite"

msgid "Using {method} {product_key} for locale"
msgstr "Utilizzo di {method} {product_key} per le impostazioni locali"

