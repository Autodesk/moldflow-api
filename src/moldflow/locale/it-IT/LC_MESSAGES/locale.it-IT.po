msgstr "Il JSON di assegnazione proprietà deve essere un oggetto con un solo campo 'value'."

msgid "Property assignment requires exactly one 'value' argument (e.g., value=... or --params-json '{\"value\": ...}')."
msgstr "L'assegnazione della proprietà richiede esattamente un argomento 'value' (ad es. value=... o --params-json '{\"value\": ...}')."

msgid "Property {name} (id={id}, type={prop_type})"
msgstr "Proprietà {name} (id={id}, tipo={prop_type})"

