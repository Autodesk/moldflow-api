msgstr "解析目標 '{target}' 時，區段 '{segment}' 不是類別 '{class_name}' 上可呼叫的方法"

msgid "Selection"
msgstr "選取"

msgid "Session:"
msgstr "工作階段："

msgid "Set it with:"
msgstr "可用下列方式設定："

