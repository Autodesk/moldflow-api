msgstr "'{type_name}' n'expose plus la méthode d'adaptateur '{method_name}'."

msgid "--yaml requested but PyYAML is not installed: {error}"
msgstr "L'option --yaml a été demandée mais PyYAML n'est pas installé : {error}"

msgid "--yaml requested but PyYAML is not installed: {exc}"
msgstr "L'option --yaml a été demandée mais PyYAML n'est pas installé : {exc}"

msgid "Aborted."
msgstr "Abandonné."

